{
  "name": "@oworker/open-agent-mcp-adapter",
  "version": "0.1.0-alpha.10",
  "private": true,
  "description": "Host-neutral, tenant-scoped Eve MCP connection factory for Open Agent deployments.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "eve": "0.85.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "eve": ">=0.85.0 <0.86.0"
  },
  "engines": {
    "node": "24.x"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
