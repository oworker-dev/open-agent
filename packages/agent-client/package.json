{
  "name": "@oworker/open-agent-client",
  "version": "0.1.0-alpha.9",
  "private": true,
  "description": "Headless TypeScript client for the standalone Open Agent service.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent-run": {
      "types": "./dist/agent-run-client.d.ts",
      "import": "./dist/agent-run-client.js"
    },
    "./eve-session": {
      "types": "./dist/eve-session-client.d.ts",
      "import": "./dist/eve-session-client.js"
    },
    "./session-control": {
      "types": "./dist/session-control-client.d.ts",
      "import": "./dist/session-control-client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@oworker/open-agent-contracts": "0.1.0-alpha.9",
    "eve": ">=0.31.1 <0.32.0"
  },
  "peerDependenciesMeta": {
    "eve": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
