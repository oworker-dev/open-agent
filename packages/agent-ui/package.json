{
  "name": "@oworker/open-agent-ui",
  "version": "0.1.0-alpha.9",
  "private": true,
  "description": "Reusable assistant-ui React workspace and Eve session projection for the Open Agent service.",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent-workspace": {
      "types": "./dist/agent-workspace/index.d.ts",
      "import": "./dist/agent-workspace/index.js"
    },
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "import": "./dist/ui/*.js"
    },
    "./assistant-ui/*": {
      "types": "./dist/assistant-ui/*.d.ts",
      "import": "./dist/assistant-ui/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "check": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.5",
    "@assistant-ui/react-ai-sdk": "^1.4.4",
    "@assistant-ui/react-lexical": "^0.2.7",
    "@assistant-ui/react-markdown": "0.14.8",
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.7.1",
    "@oworker/open-agent-contracts": "0.1.0-alpha.9",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@rive-app/react-webgl2": "^4.30.0",
    "@shadcn/react": "^0.3.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.4.0",
    "diff": "9.0.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "1.16.0",
    "media-chrome": "^4.19.2",
    "motion": "12.40.0",
    "nanoid": "5.1.16",
    "next-themes": "^0.4.6",
    "parse-diff": "0.12.0",
    "radix-ui": "1.4.3",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.84.0",
    "react-jsx-parser": "^2.4.1",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.1.0",
    "sonner": "^2.0.7",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tokenlens": "^1.3.1",
    "tw-shimmer": "^0.4.12",
    "use-stick-to-bottom": "1.1.4",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "ai": ">=7.0.0 <8.0.0",
    "eve": ">=0.31.1 <0.32.0",
    "react": ">=19.2.0 <20.0.0",
    "react-dom": ">=19.2.0 <20.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.25",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
