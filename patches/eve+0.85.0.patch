+// Open Agent's durable session tool grant. Catalog controls and connection/skill
+// grants remain owned by Eve; this allowlist selects compiled/authored tools.
+import { contextStorage } from "#context/container.js";
+import { AuthKey, InitiatorAuthKey } from "#context/keys.js";
+
+export function allowedRunTools(ctx = contextStorage.getStore()) {
+  const value = ctx?.get(InitiatorAuthKey)?.attributes?.agentRunPolicy ??
+    ctx?.get(AuthKey)?.attributes?.agentRunPolicy;
+  if (value === undefined) return undefined;
+  let policy;
+  try {
+    if (typeof value !== "string") throw new Error();
+    policy = JSON.parse(value);
+    if (!policy || typeof policy !== "object" || Array.isArray(policy)) throw new Error();
+    if (policy.tools === undefined) return undefined;
+    if (!Array.isArray(policy.tools) || policy.tools.some(name => typeof name !== "string" || !name)) throw new Error();
+  } catch {
+    throw new Error("Invalid AgentRun tool policy in the session authentication snapshot.");
+  }
+  return new Set(policy.tools);
+}
