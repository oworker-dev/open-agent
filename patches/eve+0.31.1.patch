+import { createLogger } from "#internal/logging.js";
+import { DynamicSkillManifestKey, SandboxKey } from "#context/keys.js";
+import { toErrorMessage } from "#shared/errors.js";
+import { ALLOWED_DYNAMIC_SKILL_EVENTS, isBrandedSkillEntry } from "#shared/dynamic-tool-definition.js";
+import {
+  normalizeSkillPackage,
+  removeSkillPackageFromSandbox,
+  writeSkillPackageToSandbox,
+} from "#shared/skill-package.js";
+import { ContextKey } from "#context/key.js";
+import { buildResolveContext } from "#context/dynamic-resolve-context.js";
+import { formatAvailableSkillsSection } from "#execution/skills/instructions.js";
+import { resolveSandboxSkillRoot } from "#shared/skill-paths.js";
+
+const log = createLogger("dynamic-skills");
+
+function qualifyDynamicSkillNames(resolver, branded, entries) {
+  const names = Object.keys(entries);
+  if (names.length === 0) return [];
+  if (branded) return [{ name: resolver.slug, entryKey: names[0], entry: entries[names[0]] }];
+  const namespace = resolver.extensionNamespace === undefined ? "" : `${resolver.extensionNamespace}__`;
+  return names.map((name) => ({
+    name: `${namespace}${name}`,
+    entryKey: name,
+    entry: entries[name],
+  }));
+}
+
+async function formatDynamicSkillAnnouncement({ ctx, manifest }) {
+  const sandbox = await ctx.require(SandboxKey).get();
+  const skillRoot = sandbox === null ? undefined : await resolveSandboxSkillRoot({ sandbox });
+  return formatAvailableSkillsSection(Object.values(manifest).flat(), { skillRoot }) ?? "";
+}
+
+const PendingSkillAnnouncementKey = new ContextKey("eve.pendingSkillAnnouncement");
+
+async function dispatchDynamicSkillEvent({ ctx, resolvers, event, messages }) {
+  if (ctx.get(PendingSkillAnnouncementKey) === undefined) {
+    const manifest = ctx.get(DynamicSkillManifestKey);
+    if (manifest !== undefined && Object.keys(manifest).length > 0) {
+      ctx.setVirtualContext(
+        PendingSkillAnnouncementKey,
+        await formatDynamicSkillAnnouncement({ ctx, manifest }),
+      );
+    }
+  }
+  if (!ALLOWED_DYNAMIC_SKILL_EVENTS.has(event.type)) return;
+  const applicableResolvers = resolvers.filter((resolver) => resolver.eventNames.includes(event.type));
+  if (applicableResolvers.length === 0) return;
+  const resolveContext = buildResolveContext(ctx, messages);
+  const previousManifest = ctx.get(DynamicSkillManifestKey) ?? {};
+  const results = await Promise.allSettled(applicableResolvers.map(async (resolver) => {
+    const handler = resolver.events[event.type];
+    if (handler === undefined) return null;
+    const resolved = await handler(event, resolveContext);
+    if (resolved == null) return { resolver, named: [] };
+    let entries;
+    let branded;
+    if (isBrandedSkillEntry(resolved)) {
+      entries = { _single: resolved };
+      branded = true;
+    } else {
+      entries = resolved;
+      branded = false;
+    }
+    return {
+      resolver,
+      named: qualifyDynamicSkillNames(resolver, branded, entries),
+    };
+  }));
+  const contributions = [];
+  for (const result of results) {
+    if (result.status === "rejected") {
+      log.error("Dynamic skill resolver (%s) threw — skipping.", {
+        error: toErrorMessage(result.reason),
+      });
+      continue;
+    }
+    if (result.value !== null) {
+      contributions.push({
+        resolver: result.value.resolver,
+        skills: result.value.named.map(({ name, entry }) => normalizeSkillPackage({ ...entry, name })),
+      });
+    }
+  }
+  if (contributions.length === 0) return;
+
+  const manifest = { ...previousManifest };
+  for (const { resolver, skills } of contributions) {
+    if (skills.length === 0) delete manifest[resolver.slug];
+    else manifest[resolver.slug] = skills.map((skill) => ({
+      description: skill.description,
+      name: skill.name,
+    }));
+  }
+
+  // An empty initial dynamic manifest is the common standalone path. Do not
+  // open a sandbox merely to announce that there are no skills. A non-empty
+  // prior manifest still needs the sandbox cleanup below when skills are
+  // revoked or replaced.
+  if (Object.keys(manifest).length === 0 && Object.keys(previousManifest).length === 0) {
+    ctx.set(DynamicSkillManifestKey, manifest);
+    ctx.setVirtualContext(PendingSkillAnnouncementKey, "");
+    return;
+  }
+
+  const seenNames = new Map();
+  for (const [resolverSlug, skills] of Object.entries(manifest)) {
+    for (const { name } of skills) {
+      const previousResolver = seenNames.get(name);
+      if (previousResolver !== undefined) {
+        throw Error(
+          `Dynamic skill "${name}" from resolver "${resolverSlug}" collides with dynamic resolver "${previousResolver}". Namespace the map key manually, e.g. "${previousResolver}__${name}".`,
+        );
+      }
+      seenNames.set(name, resolverSlug);
+    }
+  }
+
+  const sandbox = await ctx.require(SandboxKey).get();
+  if (sandbox !== null) {
+    const currentNames = new Set(Object.values(manifest).flat().map((skill) => skill.name));
+    const removedNames = new Set();
+    for (const { resolver } of contributions) {
+      for (const previous of previousManifest[resolver.slug] ?? []) {
+        if (!currentNames.has(previous.name)) removedNames.add(previous.name);
+      }
+    }
+    for (const name of removedNames) {
+      await removeSkillPackageFromSandbox({ name, sandbox });
+    }
+    for (const { skills } of contributions) {
+      for (const skill of skills) {
+        await writeSkillPackageToSandbox({ sandbox, skill });
+      }
+    }
+  }
+  ctx.set(DynamicSkillManifestKey, manifest);
+  ctx.setVirtualContext(
+    PendingSkillAnnouncementKey,
+    await formatDynamicSkillAnnouncement({ ctx, manifest }),
+  );
+}
+
+export { PendingSkillAnnouncementKey, dispatchDynamicSkillEvent };
