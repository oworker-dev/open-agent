+import { toErrorMessage } from "#shared/errors.js";
+
+// Eve's development runtime and its compiled authored snapshot can load this
+// module through different module graphs. Keep one process-wide registry so a
+// session reset always reaches the handle that created the sandbox, regardless
+// of which graph services the reset route.
+const registryKey = Symbol.for("open-agent.eve.active-sandbox-handles.v1");
+const activeSandboxHandles = globalThis[registryKey] ??= new Map();
+const sandboxHandleIdentity = Symbol.for("eve.sandbox.handle-identity.v1");
+const sandboxShutdownListener = Symbol.for("eve.sandbox.shutdown-listener.v1");
+
+function createActiveSandboxHandleKey(backendName, sessionKey) {
+  return `${backendName}\0${sessionKey}`;
+}
+
+async function trackActiveSandboxHandle(input) {
+  const key = createActiveSandboxHandleKey(input.backendName, input.sessionKey);
+  const identity = input.handle[sandboxHandleIdentity];
+  const existing = activeSandboxHandles.get(key);
+  if (existing !== undefined) {
+    if (identity !== undefined && existing.identity === identity) return existing.handle;
+    try {
+      await existing.handle.shutdown();
+    } catch (error) {
+      // Do not overwrite the only tracked reference to compute that may still
+      // be live. Best-effort cleanup of the newly created handle keeps this
+      // fail-closed for generic backends as well as Open Agent's idle wrapper.
+      await input.handle.shutdown().catch(() => undefined);
+      throw error;
+    }
+  }
+  let operation;
+  let entry;
+  let removeShutdownListener;
+  const handle = {
+    ...input.handle,
+    shutdown() {
+      if (operation) return operation;
+      const current = input.handle.shutdown();
+      operation = current;
+      void current.then(
+        () => {
+          removeShutdownListener?.();
+          if (activeSandboxHandles.get(key) === entry) activeSandboxHandles.delete(key);
+        },
+        () => {
+          if (operation === current) operation = undefined;
+        },
+      );
+      return current;
+    },
+  };
+  entry = { handle, identity, sessionId: input.sessionId };
+  activeSandboxHandles.set(key, entry);
+  if (typeof input.handle[sandboxShutdownListener] === "function") {
+    removeShutdownListener = input.handle[sandboxShutdownListener](() => {
+      if (activeSandboxHandles.get(key) === entry) activeSandboxHandles.delete(key);
+    });
+  }
+  return handle;
+}
+
+async function shutdownSandboxEntries(entries, options) {
+  const results = await Promise.allSettled(entries.map(([, entry]) => entry.handle.shutdown()));
+  for (const [index, result] of results.entries()) {
+    if (result.status === "rejected") {
+      const entry = entries[index];
+      options?.log?.(
+        `failed to shut down sandbox "${entry?.[0] ?? "unknown"}": ${toErrorMessage(result.reason)}`,
+      );
+    }
+  }
+}
+
+async function shutdownActiveSandboxHandles(options) {
+  const entries = [...activeSandboxHandles.entries()];
+  await shutdownSandboxEntries(entries, options);
+}
+
+/** Stops every tracked sandbox handle owned by one durable session. */
+async function shutdownActiveSandboxHandlesForSession(sessionId, options) {
+  const entries = [...activeSandboxHandles.entries()].filter(([, entry]) => entry.sessionId === sessionId);
+  await shutdownSandboxEntries(entries, options);
+}
+
+function countActiveSandboxHandles() {
+  return activeSandboxHandles.size;
+}
+
+function clearActiveSandboxHandlesForTest() {
+  activeSandboxHandles.clear();
+}
+
+export {
+  clearActiveSandboxHandlesForTest,
+  countActiveSandboxHandles,
+  shutdownActiveSandboxHandles,
+  shutdownActiveSandboxHandlesForSession,
+  trackActiveSandboxHandle,
+};
