{
  "name": "open-agent",
  "version": "0.1.0-alpha.9",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "npm run build:sdk && next build && npm run verify:embed-build",
    "build:sdk": "npm run build --workspace @oworker/open-agent-contracts && npm run build --workspace @oworker/open-agent-client && npm run build --workspace @oworker/open-agent-host && npm run build --workspace @oworker/open-agent-ui && npm run build --workspace @oworker/open-agent-mcp-adapter",
    "db:migrate": "node scripts/migrate-agent-data.mjs",
    "dev": "npm run build:sdk && next dev",
    "start": "next start",
    "start:preview": "node scripts/run-production-preview.mjs",
    "infra:local-production": "node scripts/setup-local-production-infrastructure.mjs up",
    "infra:local-production:status": "node scripts/setup-local-production-infrastructure.mjs status",
    "infra:local-production:stop": "node scripts/setup-local-production-infrastructure.mjs stop",
    "typecheck": "npm run build:sdk && tsc --noEmit -p tsconfig.json",
    "build:eve": "npm run build:sdk && WORKFLOW_TARGET_WORLD=@workflow/world-postgres eve build",
    "build:eve:local": "npm run build:sdk && WORKFLOW_TARGET_WORLD= eve build",
    "build:examples": "npm run build --workspace @oworker/open-agent-example-custom-host-react",
    "dev:eve": "eve dev",
    "doctor:production": "node scripts/doctor-production.ts",
    "doctor:host": "node scripts/doctor-host-resources.mjs",
    "eval:fixed": "node scripts/run-fixed-evals.mjs",
    "start:eve": "eve start",
    "start:mailbox-worker": "node scripts/run-agent-mailbox-worker.mjs",
    "start:run-reconciler": "node scripts/run-agent-run-reconciler.mjs",
    "test:e2e": "playwright test",
    "test:unit": "npm run build:sdk && node --test tests/unit/*.test.ts",
    "verify:ci": "npm run typecheck && npm run test:unit && npm run verify:provider-failures && npm run verify:mcp-conformance && npm run build:eve && npm run build && npm run verify:sdk-source-distribution && npm run verify:sdk-packages && npm run verify:custom-host-example",
    "verify:embed-build": "node scripts/verify-embed-build.mjs",
    "verify:agent-run-api": "node scripts/verify-agent-run-api.mjs",
    "verify:asset-load": "node scripts/verify-asset-upload-load.mjs",
    "verify:capacity": "node scripts/verify-single-server-capacity.mjs",
    "verify:asset-production": "node scripts/verify-asset-production.mjs",
    "verify:custom-host-example": "npm run build:examples",
    "verify:sdk-packages": "npm run build:sdk && node scripts/verify-sdk-packages.mjs",
    "verify:sdk-source-distribution": "node scripts/verify-sdk-source-distribution.mjs",
    "verify:sandbox": "node scripts/verify-sandbox-docker.mjs",
    "verify:sandbox-runtime": "node scripts/verify-sandbox-runtime.mjs",
    "verify:muses-host-e2e": "node scripts/verify-muses-host-e2e.mjs",
    "mock:openai": "node scripts/mock-openai-responses.mjs",
    "mock:otlp": "node scripts/mock-otlp-json.mjs",
    "postinstall": "patch-package",
    "reap:sandboxes": "node scripts/reap-docker-sandboxes.mjs",
    "reap:workflow": "node scripts/reap-workflow-runs.mjs",
    "reap:assets": "node scripts/reap-assets.mjs",
    "start:asset-cleanup": "node scripts/run-asset-cleanup-worker.mjs",
    "start:sandbox-cleanup": "node scripts/run-sandbox-cleanup-worker.mjs",
    "verify:otel": "node scripts/verify-otel-export.mjs",
    "verify:extensions": "node scripts/verify-extension-lifecycle.mjs",
    "verify:live-autonomy": "node scripts/verify-live-autonomy.mjs",
    "verify:load": "node scripts/verify-agent-run-load.mjs",
    "verify:mixed-capacity": "node scripts/verify-mixed-capacity.mjs",
    "verify:stream-recovery": "node scripts/verify-stream-recovery.mjs",
    "verify:stream-load": "node scripts/verify-idle-stream-load.mjs",
    "verify:mcp-conformance": "node scripts/verify-mcp-conformance.mjs",
    "verify:provider-failures": "node scripts/verify-provider-failures.mjs",
    "verify:sandbox-reaper": "node scripts/verify-sandbox-reaper.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.24",
    "@assistant-ui/core": "0.3.6",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@opentelemetry/api": "1.9.1",
    "@oworker/open-agent-client": "0.1.0-alpha.9",
    "@oworker/open-agent-contracts": "0.1.0-alpha.9",
    "@oworker/open-agent-host": "0.1.0-alpha.9",
    "@oworker/open-agent-ui": "0.1.0-alpha.9",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@shikijs/core": "4.1.0",
    "@shikijs/engine-javascript": "4.1.0",
    "@shikijs/engine-oniguruma": "4.1.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.0",
    "@vercel/connect": "0.4.2",
    "@vercel/otel": "^2.1.3",
    "@workflow/world-postgres": "5.0.0-beta.33",
    "ai": "^7.0.34",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "eve": "0.31.1",
    "ipaddr.js": "2.2.0",
    "lucide-react": "1.16.0",
    "motion": "12.40.0",
    "nanoid": "5.1.16",
    "next": "16.3.0-preview.10",
    "pg": "^8.22.0",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shiki": "4.1.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "use-stick-to-bottom": "1.1.4",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "24.x",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "patch-package": "^8.0.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "ai": "^7.0.34",
    "dompurify": "3.4.13",
    "js-yaml": "4.3.1",
    "mermaid": "11.16.1",
    "nanoid": "5.1.16",
    "postcss": "8.5.25"
  },
  "engines": {
    "node": "24.x"
  }
}
