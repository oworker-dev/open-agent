# Model provider. For a Muses-hosted deployment, use the private Muses broker:
# OPENAI_API_KEY=<MUSES_AGENT_PROVIDER_BROKER_SECRET>
# OPENAI_BASE_URL=http://127.0.0.1:4730/api/internal/agent-provider/v1
# Direct standalone deployments may instead use their own Provider credential.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Use mock only for deterministic local verification. Production must use live.
AGENT_PROVIDER_MODE=live
AGENT_MODEL_ID=gpt-5.6-sol
# Maximum tokens requested from the Provider for one model step. Keep this
# separate from AgentRun/session cumulative token budgets.
AGENT_MODEL_MAX_OUTPUT_TOKENS=4096
# End-to-end deadline for one direct Provider HTTP/SSE request. Eve owns the
# outer observable transient retry loop; this bounds hung sockets and streams.
AGENT_PROVIDER_HTTP_TIMEOUT_MS=120000
# Test-only context-window override used by deterministic compaction evals.
# Never configure this or AGENT_EVAL_FIXTURE_MODEL in production.
AGENT_EVAL_CONTEXT_WINDOW_TOKENS=
# High-impact shell commands require durable user approval. Production accepts
# risky or always; never is intentionally rejected by the production doctor.
AGENT_BASH_APPROVAL_MODE=risky

# Signed static previews published from an Agent session. The URL is a bearer
# link with a bounded lifetime; keep this secret outside the repository.
AGENT_PUBLIC_BASE_URL=http://127.0.0.1:3100
AGENT_PREVIEW_SIGNING_SECRET=
AGENT_PREVIEW_TTL_SECONDS=86400
# Standalone/local fallback when AGENT_DATABASE_URL is not configured. Production
# uses the database-backed preview store and rejects an implicit local store.
AGENT_PREVIEW_STORAGE_PATH=.eve/previews
AGENT_ARTIFACT_STORAGE_PATH=.eve/artifacts
# Host-neutral user asset storage. `filesystem` is development-only. Production
# may use the built-in PostgreSQL metadata + S3-compatible object adapter, or
# inject a custom host AssetStore at bootstrap.
AGENT_ASSET_STORAGE_BACKEND=filesystem
AGENT_ASSET_STORAGE_PATH=.eve/assets
AGENT_ASSET_S3_ENDPOINT=
AGENT_ASSET_S3_REGION=us-east-1
AGENT_ASSET_S3_BUCKET=
AGENT_ASSET_S3_ACCESS_KEY_ID=
AGENT_ASSET_S3_SECRET_ACCESS_KEY=
AGENT_ASSET_S3_FORCE_PATH_STYLE=true
AGENT_ASSET_S3_PREFIX=open-agent
# Short-lived browser-to-object-store multipart URLs. The bucket CORS policy
# must allow PUT from the Web origin and expose the ETag response header.
AGENT_ASSET_UPLOAD_URL_TTL_SECONDS=900
AGENT_ASSET_MAX_BYTES=10GiB
# Aggregate quota per authenticated tenant/principal. Set this explicitly for
# production S3 deployments; the per-object limit above remains independent.
AGENT_ASSET_QUOTA_BYTES=
# Content scanning is host-provided for untrusted production assets. Use
# `disabled` only for local development/tests; production defaults to required
# and fails closed unless configureAssetScanner() registers an adapter.
AGENT_ASSET_SCAN_MODE=disabled
# Optional standalone production scanner. When scan mode is `required`, the
# reference Web server registers this clamd INSTREAM adapter at Node startup.
# A host embedding the kernel may instead inject its own AssetScanner.
AGENT_ASSET_CLAMAV_HOST=
AGENT_ASSET_CLAMAV_PORT=3310
AGENT_ASSET_CLAMAV_TIMEOUT_MS=120000
# Run `npm run reap:assets` from a scheduled worker. The command deletes expired
# completed objects and aborts expired multipart uploads; it is intentionally
# separate from request handling so cleanup cannot block user uploads.
AGENT_ASSET_CLEANUP_LIMIT=100
AGENT_ASSET_CLEANUP_INTERVAL_MS=3600000
# Staged multipart capacity gate (npm run verify:asset-load). Keep the default
# 100 MiB fixture and bounded concurrency for a release regression baseline.
AGENT_ASSET_LOAD_BASE_URL=http://127.0.0.1:3100
AGENT_ASSET_LOAD_CONCURRENCY=2
AGENT_ASSET_LOAD_TOTAL_UPLOADS=2
AGENT_ASSET_LOAD_SIZE_BYTES=100MiB
AGENT_ASSET_LOAD_EVIDENCE_PATH=
AGENT_ASSET_PRODUCTION_EVIDENCE_PATH=
# Optional extra browser origin for the reproducible local MinIO CORS fixture.
AGENT_LOCAL_PRODUCTION_PUBLIC_ORIGIN=

# Authenticated reconnectable stream capacity gate. Scale TOTAL through
# 100/1k/5k/10k on the selected production topology.
AGENT_STREAM_LOAD_BASE_URL=http://127.0.0.1:3100
AGENT_STREAM_LOAD_TOTAL=100
AGENT_STREAM_LOAD_CONCURRENCY=100
AGENT_STREAM_LOAD_HOLD_MS=5000
AGENT_STREAM_LOAD_HANDSHAKE_DEADLINE_MS=30000
AGENT_STREAM_LOAD_MAX_ERROR_RATE=0
AGENT_STREAM_LOAD_P95_HANDSHAKE_MS=5000
AGENT_STREAM_LOAD_EVIDENCE_PATH=

# Sequential single-server capacity matrix. The runner reuses bounded load
# verifiers, stops at the first failed level, and never deletes test fixtures.
AGENT_CAPACITY_STREAM_LEVELS=100,250,500,1000
AGENT_CAPACITY_RUN_LEVELS=1,2,4,8
AGENT_CAPACITY_STREAM_WORKERS=100
AGENT_CAPACITY_BATCH_TIMEOUT_MS=900000
AGENT_CAPACITY_STOP_ON_FAILURE=1
AGENT_CAPACITY_EVIDENCE_DIR=.tmp/capacity
AGENT_CAPACITY_EVIDENCE_PATH=
# Refuse a capacity run when the host has less free disk than this margin. A
# load test must never be the reason a Workflow database exhausts its volume.
AGENT_CAPACITY_MIN_FREE_DISK_BYTES=2GiB
# The capacity matrix observes Provider completion latency while its pass/fail
# gate uses local admission/error/throughput dimensions. Standalone SLO tests
# may set this to `enforce` and configure AGENT_LOAD_P95_COMPLETION_MS.
AGENT_LOAD_COMPLETION_SLO_MODE=observe
AGENT_LOAD_P95_COMPLETION_MS=60000

# Workflow retention is read-only by default. Applying deletion requires both
# WORKFLOW_RETENTION_APPLY=1 and WORKFLOW_RETENTION_CONFIRM=delete-workflow-runs.
WORKFLOW_POSTGRES_SCHEMA=workflow
WORKFLOW_RETENTION_MAX_RUNS=100
WORKFLOW_RETENTION_OLDER_THAN_MS=604800000
WORKFLOW_RETENTION_SCAN_LIMIT=10000
WORKFLOW_RETENTION_EVIDENCE_PATH=.tmp/workflow-retention-evidence.json

# Production host authentication. The host signs short-lived JWTs containing
# sub, tenantId, and optional actorType (user or service).
AGENT_HOST_JWT_SECRET=
AGENT_HOST_JWT_ISSUER=
AGENT_HOST_JWT_AUDIENCE=
AGENT_HOST_JWT_ALGORITHM=HS256
AGENT_HOST_JWT_CLOCK_SKEW_SECONDS=30
# Comma-separated exact origins allowed to frame /embed.
AGENT_EMBED_ALLOWED_ORIGINS=http://localhost:4730,http://127.0.0.1:4730
# Development only: extra exact hostnames/IPs allowed to load Next dev assets.
# A remote preview launcher should discover its current address and inject it at startup.
AGENT_DEV_ALLOWED_ORIGINS=

# Optional host-owned capability bridge. Leave unset when running this Agent
# as a standalone product. For Muses, use the route base ending in
# /api/studio/agent-host-tools and the same HMAC secret on both services.
AGENT_HOST_TOOLS_URL=
AGENT_HOST_TOOLS_SECRET=
AGENT_HOST_TOOLS_TIMEOUT_MS=120000

# Agent product data: session ownership, thread indexes, and headless run records.
# This may share the host application's database because it uses an independent
# schema and migration lifecycle. It must not point at the Eve Workflow World
# database configured below.
AGENT_DATABASE_URL=
AGENT_DATABASE_SCHEMA=open_agent
AGENT_DATABASE_MAX_POOL_SIZE=10

# Headless AgentRun API connection to the independently deployed Eve runtime.
# Use the origin/base path before /eve/v1; Eve Client appends that route prefix.
AGENT_RUNTIME_URL=
AGENT_RUNTIME_HOST_HEADER=
AGENT_RUNTIME_REQUEST_TIMEOUT_MS=15000
# Server-owned follow-up mailbox. Use two independent 32-byte secrets: the
# worker credential protects the Web dispatcher route, while the dispatch
# signature authenticates Web-to-Eve admission requests.
AGENT_MAILBOX_WORKER_SECRET=
AGENT_MAILBOX_DISPATCH_SECRET=
AGENT_MAILBOX_WORKER_INTERVAL_MS=1000
# Required only by the separate mailbox worker process.
AGENT_WEB_INTERNAL_URL=http://127.0.0.1:3100
# Give Eve cooperative cancellation a bounded window before an exclusive
# Headless AgentRun session is terminally reset.
AGENT_RUN_CANCELLATION_GRACE_MS=1000

# Self-hosted durable Workflow World. Set these during both `eve build` and
# `eve start`; omit them to keep the local development world. This must be a
# physically separate database from Muses Workflow and AGENT_DATABASE_URL.
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
WORKFLOW_POSTGRES_URL=
WORKFLOW_POSTGRES_JOB_PREFIX=open_agent_
WORKFLOW_POSTGRES_WORKER_CONCURRENCY=20
WORKFLOW_POSTGRES_MAX_POOL_SIZE=22
# Trust boundary for the deployment. Multi-tenant production rejects the Eve
# Docker backend because it lacks the required microVM and resource controls.
AGENT_DEPLOYMENT_TENANCY=single-tenant
# Production builds must pin one backend. Local development may use `auto`.
AGENT_SANDBOX_BACKEND=auto
# Production must use an immutable digest for the reviewed runtime image.
AGENT_SANDBOX_IMAGE=
# Logical per-session reservation for assets materialized into /workspace by
# import_asset. Keep this at or below the physical sandbox disk quota.
AGENT_SANDBOX_WORKSPACE_QUOTA_BYTES=10GiB
# Docker keeps one persistent container per durable session. Production Docker
# deployments must define and schedule an explicit retention policy. Session
# ids listed here are never selected by the operator reaper.
EVE_SANDBOX_RETENTION_HOURS=168
EVE_SANDBOX_REAPER_MAX_REMOVALS=50
EVE_SANDBOX_PROTECTED_SESSION_IDS=
# Terminal sessions are retired first, then their exact Eve Docker container
# is removed by the authorization-backed sandbox cleanup worker.
AGENT_SANDBOX_TERMINAL_RETENTION_HOURS=168
AGENT_SANDBOX_CLEANUP_INTERVAL_MS=900000
AGENT_SANDBOX_CLEANUP_MAX_SESSIONS=25
# Baked into the Next production rewrite; keep it equal to the Eve start port.
EVE_NEXT_PRODUCTION_PORT=4275
# Standard OpenTelemetry export. Use the same collector as Muses. Synchronous
# hops share W3C context; durable Agent turns link to their originating span.
# Vercel deployments may use the platform collector instead.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1
# Comma-separated, version-pinned emergency revocation list, for example:
# AGENT_REVOKED_EXTENSIONS=software-task@1.0.0
AGENT_REVOKED_EXTENSIONS=
